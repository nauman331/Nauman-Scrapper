{
  "name": "scraperoverall",
  "version": "1.0.0",
  "description": "Production-Ready Web Scraping Platform with Crawlee, Playwright, Prisma, and Fastify",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "worker": "tsx src/worker-runner.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "scraper",
    "crawlee",
    "playwright",
    "cheerio",
    "fastify",
    "prisma",
    "bullmq"
  ],
  "author": "Production Engineering",
  "license": "ISC",
  "dependencies": {
    "@crawlee/cheerio": "^3.18.2",
    "@crawlee/playwright": "^3.18.2",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@prisma/client": "5.22.0",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.4.21",
    "bullmq": "^6.4.0",
    "cheerio": "^1.2.0",
    "crawlee": "^3.18.2",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "got-scraping": "^4.2.2",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "postcss-nesting": "^13.0.2",
    "postcss-selector-parser": "^6.1.5",
    "socks-proxy-agent": "^10.1.0",
    "svgo": "^4.1.0",
    "tailwindcss": "3.4.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "prisma": "5.22.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
