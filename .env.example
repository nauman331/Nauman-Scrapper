# Database Connection (SQLite local file by default, or MySQL live url)
# For SQLite local file:
DATABASE_URL="file:./scrape.db"
# For MySQL live:
# DATABASE_URL="mysql://user:password@localhost:3306/scrapedb"
# Server Configuration
PORT=3200
HOST="0.0.0.0"
NODE_ENV="development"
LOG_LEVEL="warn"
# Security & Authentication
# API Key for endpoints (Set empty or undefined to disable in local dev if desired, or provide key)
API_KEY="dev-scrape-secret-key-2026"
# Queue Configuration
# QUEUE_ADAPTER can be "memory" or "redis".
# "memory" uses a parent-owned queue with local Node.js worker processes (no Redis)
# "redis" connects to Redis with BullMQ for distributed worker fleets
QUEUE_ADAPTER="memory"
LOCAL_WORKER_PROCESSES=5
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
# Crawler Limits & Defaults
DEFAULT_CONCURRENCY=5
MAX_GLOBAL_CONCURRENCY=20
DEFAULT_TIMEOUT_MS=30000
MAX_REQUEST_TIMEOUT_MS=120000
MAX_CRAWL_DEPTH=5
MAX_PAGES_PER_JOB=100
# SSRF Protection
ALLOW_PRIVATE_NETWORKS=false